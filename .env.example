# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=alyp_satu
POSTGRES_USER=alyp_satu
POSTGRES_PASSWORD=alyp_satu_dev_password
POSTGRES_PORT=5432

# Django database connection string
# Inside Docker Compose, host is `db`; for local non-Docker dev against Dockerized Postgres, use `localhost`.
DATABASE_URL=postgres://alyp_satu:alyp_satu_dev_password@db:5432/alyp_satu

# Django core settings (safe local development defaults — never use in production)
DJANGO_SECRET_KEY=django-insecure-local-dev-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Trusted origins for CSRF checks (defaults to http://localhost:5173,http://127.0.0.1:5173 if unset)
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Cookie security flags (keep False for local HTTP development; set True behind HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
